# ============================================================
# 竞品监控服务 · 配置模板
# 复制成 .env 后按需修改。不带 .env 也能启动，只是功能会降级。
# ============================================================

# ---- 服务 ----
APP_HOST=0.0.0.0
APP_PORT=8100
APP_ENV=dev
LOG_LEVEL=INFO

# ---- 数据库 ----
# MVP 用 SQLite；要上 PostgreSQL 就改这一行，其余代码不用动
DATABASE_URL=sqlite:///./data/competitor_monitor.db
# DATABASE_URL=postgresql+psycopg2://user:pass@127.0.0.1:5432/competitor

# ---- 卖家精灵转接桥（必须先启动它）----
SELLERSPRITE_BRIDGE_URL=http://127.0.0.1:8000
SELLERSPRITE_TIMEOUT=60

# ---- DeepSeek（Agent 对话用；不配也能收日报和预警）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---- 飞书自建应用 ----
# 开发者后台 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 事件订阅 → 安全设置（不填则跳过校验，仅建议本地调试用）
FEISHU_VERIFICATION_TOKEN=
# 如果开了加密推送，把 Encrypt Key 填这里
FEISHU_ENCRYPT_KEY=
# 默认推送目标：群聊的 chat_id（oc_ 开头）
FEISHU_DEFAULT_CHAT_ID=

# ---- 租户 ----
TENANT_ID=default
TENANT_NAME=我的店铺

# ---- 调度 ----
DAILY_BRIEF_HOUR=9
DAILY_BRIEF_MINUTE=0
SCHEDULER_ENABLED=true
COLLECT_INTERVAL_MINUTES=60
BLAST_INTERVAL_MINUTES=15
P0_PUSH_ENABLED=true
POOL_MAINTAIN_WEEKDAY=0
POOL_MAINTAIN_HOUR=4
